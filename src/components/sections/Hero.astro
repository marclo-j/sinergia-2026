---
import { Image } from "astro:assets";
import heroBg from "@/assets/hero/bg.webp";
import heroSinergia from "@/assets/hero/sinergia.webp";
import { LabelSlideButton } from "@/components/LabelSlideButton";
---

<section class="grain-overlay relative h-[985px] overflow-hidden">
  <Image
    src={heroBg}
    alt=""
    width={1458}
    height={800}
    fetchpriority="high"
    class="object-cover absolute inset-x-0 top-[-15%] z-[1] h-[115%] w-full"
    data-parallax="0.15"
  />
  <div class="absolute inset-0 surface-heat opacity-80"></div>
  <Image
    src={heroSinergia}
    alt=""
    class="absolute inset-0 z-[5] mx-auto my-auto min-h-[870px] w-auto object-contain"
  />
  <div class="absolute inset-0 bg-black/20 z-[8]"></div>

  <div class="relative z-10 flex min-h-[calc(985px-10rem)] flex-col justify-end gap-10 pl-4 pr-4 pt-10 pb-4 md:pl-10 md:pr-10 md:pt-16 md:pb-6">
    <div class="flex flex-col gap-6" data-animate="fade-up">
      <h1 class="font-bold text-5xl leading-[0.9] text-primary-foreground md:text-7xl lg:text-8xl">
        A través<br />del tiempo
      </h1>
      <p class="max-w-md text-3xl font-medium text-primary-foreground uppercase">
        Todo cambia, Él permanece
      </p>
      <LabelSlideButton
        client:load
        link="/inscripcion"
        newTab={false}
        label="Quiero ser parte"
        rounded={100}
        padding="16px 28px"
        font={{ fontSize: 24, fontWeight: 700, letterSpacing: "0.05em", textTransform: "uppercase", fontFamily: "Poppins, sans-serif" }}
        style={{ alignSelf: "flex-start" }}
        colors={{ fill: "#102a49", textColor: "#ffffff", hoverFill: "#FC731C", hoverTextColor: "#ffffff" }}
        icon={{ side: "left", background: "#204e84", color: "#ffffff", hoverBackground: "#ffffff", hoverColor: "#102a49", size: 22, padding: 12, rounded: 100, restSymbol: "↗", hoverSymbol: "↗", angle: 315 }}
        border={{ borderColor: "#102a49", borderStyle: "solid", borderWidth: 0 }}
        gap={20}
      />
      <p class="font-semibold text-2xl text-primary-foreground uppercase">
        ¡Preventa con cupos limitados!
      </p>
    </div>
  </div>

  <div class="absolute top-16 md:top-24 right-4 z-20 flex flex-col items-end gap-10 md:gap-16 font-nav text-primary-foreground md:right-10">
    <div class="flex items-end gap-3">
      <div class="flex flex-col gap-5 items-end">
        <span class="font-bold text-6xl md:text-8xl leading-none">30</span>
        <span class="font-bold text-6xl md:text-8xl leading-none">31</span>
      </div>
      <span class="font-semibold vertical-text-cc text-xl md:text-3xl tracking-[0.25em] uppercase">Octubre</span>
    </div>
    <div class="flex gap-2">
      <span class="font-bold text-6xl md:text-8xl leading-none">01</span>
      <span class="font-semibold vertical-text-cc text-xl md:text-3xl tracking-[0.25em] uppercase">Noviembre</span>
    </div>
  </div>
</section>
