---
import { Image } from "astro:assets";
import heroBg from "@/assets/hero/bg.webp";
import heroSinergia from "@/assets/hero/sinergia_portada.webp";
import { LabelSlideButton } from "@/components/LabelSlideButton";
---

<section class="grain-overlay relative h-[985px] overflow-hidden">
  <Image
    src={heroBg}
    alt=""
    width={2658}
    height={2000}
    fetchpriority="high"
    class="object-cover absolute inset-x-0 top-[-15%] z-[1] h-[115%] w-full"
    data-parallax="0.15"
  />
  <div class="absolute inset-0 surface-heat opacity-80"></div>
  <div class="absolute inset-0 bg-black/20 z-[2]"></div>

  <div class="relative z-10 flex h-full flex-col items-center justify-center gap-10 px-4 lg:flex-row md:gap-6 md:px-10">
    <div class="flex w-full flex-col items-center text-center md:w-1/2 lg:items-start lg:text-left">
      <div class="mb-8 flex items-end gap-6 text-white md:gap-10" data-animate="fade-up">
        <div class="flex flex-col items-center leading-none">
          <span class="font-nav font-bold text-5xl md:text-6xl">30</span>
          <span class="font-nav font-semibold mt-1 text-sm tracking-[0.2em] uppercase md:text-base">Oct</span>
        </div>
        <div class="flex flex-col items-center leading-none">
          <span class="font-nav font-bold text-5xl md:text-6xl">31</span>
          <span class="font-nav font-semibold mt-1 text-sm tracking-[0.2em] uppercase md:text-base">Oct</span>
        </div>
        <div class="flex flex-col items-center leading-none">
          <span class="font-nav font-bold text-5xl md:text-6xl">01</span>
          <span class="font-nav font-semibold mt-1 text-sm tracking-[0.2em] uppercase md:text-base">Nov</span>
        </div>
      </div>

      <div class="flex flex-col items-center gap-6 lg:items-start" data-animate="fade-up">
        <h1 class="font-bold text-5xl leading-[0.9] text-primary-foreground md:text-6xl lg:text-9xl">
          A través<br />del tiempo
        </h1>
        <p class="max-w-md text-3xl font-medium text-primary-foreground uppercase">
          Todo cambia, Él permanece
        </p>
        <LabelSlideButton
          client:load
          link="/inscripcion"
          newTab={false}
          label="Quiero ser parte"
          rounded={100}
          padding="16px 28px"
          font={{ fontSize: 24, fontWeight: 700, letterSpacing: "0.05em", textTransform: "uppercase", fontFamily: "Poppins, sans-serif" }}
          colors={{ fill: "#102a49", textColor: "#ffffff", hoverFill: "#FC731C", hoverTextColor: "#ffffff" }}
          icon={{ side: "left", background: "#204e84", color: "#ffffff", hoverBackground: "#ffffff", hoverColor: "#102a49", size: 22, padding: 12, rounded: 100, restSymbol: "↗", hoverSymbol: "↗", angle: 315 }}
          border={{ borderColor: "#102a49", borderStyle: "solid", borderWidth: 0 }}
          gap={20}
        />
        <p class="font-semibold text-2xl text-primary-foreground uppercase">
          ¡Preventa con cupos limitados!
        </p>
      </div>
    </div>

    <div class="flex w-full items-center justify-center md:w-1/2">
      <Image
        src={heroSinergia}
        alt=""
        class="h-auto max-h-[70%] w-auto max-w-full scale-[1.4] object-contain"
        data-animate="fade-up"
      />
    </div>
  </div>
</section>
