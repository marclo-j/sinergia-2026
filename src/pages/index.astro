---
import Layout from "@/layouts/Layout.astro";
import { getImage } from "astro:assets";
import heroBg from "@/assets/hero/bg.webp";
import { SiteHeader } from "@/components/SiteHeader";
import SiteFooter from "@/components/SiteFooter.astro";
import Hero from "@/components/sections/Hero.astro";
import CountdownSection from "@/components/sections/CountdownSection.astro";
import QueEsSinergia from "@/components/sections/QueEsSinergia.astro";
import TresDias from "@/components/sections/TresDias.astro";
import Pilares from "@/components/sections/Pilares.astro";
import CtaSection from "@/components/sections/CtaSection.astro";

const ogImage = await getImage({ src: heroBg, width: 1200, format: "webp" });
---

<Layout
  title="Sinergia Vol. II — A través del tiempo | Conferencia 2026"
  description="Conferencia Sinergia Vol. II: 30 y 31 de octubre y 1 de noviembre. Inscríbete, paga tu entrada y recibe tu QR de acceso."
  ogTitle="Sinergia Vol. II — A través del tiempo"
  ogDescription="Tres días de adoración, talleres y conexión. Preventa S/ 10."
  preloadImage={ogImage.src}
>
  <SiteHeader client:load currentPath="/" />
  <Hero />
  <CountdownSection />
  <QueEsSinergia />
  <TresDias />
  <Pilares />
  <CtaSection />
  <SiteFooter />
</Layout>
