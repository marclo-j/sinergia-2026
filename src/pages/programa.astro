---
import Layout from "@/layouts/Layout.astro";
import { SiteHeader } from "@/components/SiteHeader";
import SiteFooter from "@/components/SiteFooter.astro";
import ComingSoon from "@/components/ComingSoon.astro";
---

<Layout
  title="Programa de los 3 días | Sinergia Vol. II"
  description="Línea de tiempo completa de la conferencia Sinergia Vol. II: sesiones, talleres y noches de adoración del 30 y 31 de octubre y 1 de noviembre."
  ogTitle="Programa | Sinergia Vol. II"
  ogDescription="Horarios y actividades de los tres días de la conferencia."
>
	<div class="min-h-screen bg-background">
		<SiteHeader client:load currentPath="/programa" />

		<section class="grain-overlay relative surface-heat">
			<div class="relative z-10 mx-auto max-w-4xl px-4 py-16">
				<p class="font-display text-xs tracking-[0.3em] text-primary-foreground/80">
					30 · 31 Oct · 01 Nov 2026
				</p>
				<h1 class="mt-3 font-display text-4xl leading-none text-primary-foreground md:text-6xl">
					Programa<br />de los 3 días
				</h1>
				<p class="mt-4 max-w-xl text-primary-foreground/90">
					Cada bloque está pensado para que aprendas, adores y conectes. Los horarios pueden
					ajustarse ligeramente el día del evento.
				</p>
			</div>
		</section>

		<ComingSoon
			title="El itinerario se publicará pronto"
			message="Estamos afinando los horarios de los 3 días. Vuelve pronto para ver la línea de tiempo completa."
		/>

		<SiteFooter />
	</div>
</Layout>
