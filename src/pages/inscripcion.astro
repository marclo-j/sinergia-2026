---
import Layout from "@/layouts/Layout.astro";
import { SiteHeader } from "@/components/SiteHeader";
import SiteFooter from "@/components/SiteFooter.astro";
import { InscripcionForm } from "@/components/islands/InscripcionForm";

const PRICE = 10;
---

<Layout
  title="Inscripción y pago | Sinergia Vol. II"
  description="Inscríbete a Sinergia Vol. II en 3 pasos: completa tus datos, paga por Yape, Plin o transferencia y recibe tu entrada con código QR."
  ogTitle="Inscripción | Sinergia Vol. II"
  ogDescription="Preventa S/ 10. Pago por Yape, Plin o transferencia."
>
	<div class="min-h-screen bg-background">
		<SiteHeader client:load currentPath="/inscripcion" />

		<section class="grain-overlay relative surface-heat">
			<div class="relative z-10 mx-auto max-w-3xl px-4 py-14">
				<h1 class="font-display text-4xl text-primary-foreground md:text-5xl">Inscripción</h1>
				<p class="mt-3 text-primary-foreground/90">
					Preventa S/ {PRICE}.00 — incluye acceso a los 3 días y el kit del asistente.
				</p>
			</div>
		</section>

		<InscripcionForm client:load />

		<SiteFooter />
	</div>
</Layout>
